{
  "manifest_version": 3,
  "name": "CreepingScripts",
  "version": "1.1.0",
  "description": "Categorized Web Design & Development Bookmarklet Toolkit with Automated URL Rule Injector, layout inspections, accessibility, and visual debugging.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CreepingScripts Toolset & Auto-Injector"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
